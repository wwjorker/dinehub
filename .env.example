# Copy to .env for local overrides. Never commit the real .env file.
DINEHUB_APP_PORT=8080
DINEHUB_H5_BASE_URL=http://localhost:8080/h5/index.html

# Infrastructure ports stay on this computer by default.
DINEHUB_INFRA_BIND_HOST=127.0.0.1
DINEHUB_DB_PORT=3307
DINEHUB_REDIS_PORT=6379
DINEHUB_MQ_PORT=5672
DINEHUB_MQ_MANAGEMENT_PORT=15672

# Local-only credentials. Change them before any shared or public deployment.
DINEHUB_DB_PASSWORD=root
DINEHUB_MQ_USERNAME=dinehub
DINEHUB_MQ_PASSWORD=dinehub
